# Get one at console.anthropic.com
ANTHROPIC_API_KEY=

# Get one at console.cloud.google.com -> enable "Places API"
# Leave blank to run with mock restaurant data instead
GOOGLE_PLACES_API_KEY=

PORT=3000

# Optional: where the SQLite database lives (defaults to server/data.db)
# DATABASE_PATH=

# Optional: new restaurant alerts - search radius around each device, and how
# often to check (needs GOOGLE_PLACES_API_KEY)
# NEW_PLACES_RADIUS_MILES=2
# NEW_PLACES_CHECK_HOURS=12
